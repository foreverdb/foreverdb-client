# Maintainer: Alex Bangert
# Builds from the checkout this file lives in (no download):
#   cd packaging/arch && makepkg -si
# Keep pkgver in sync with package.json, src-tauri/Cargo.toml and src-tauri/tauri.conf.json.
pkgname=foreverdb-uploader
pkgver=0.2.0
pkgrel=1
pkgdesc="Uploads ForeverCollect SavedVariables from World of Warcraft: Forever to ForeverDB"
arch=('x86_64')
url="https://github.com/foreverdb/foreverdb"
license=('MIT')
conflicts=('foreverdb-client')
replaces=('foreverdb-client')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'pango' 'gdk-pixbuf2' 'libayatana-appindicator')
makedepends=('cargo' 'rust' 'pnpm' 'nodejs')
options=('!lto' '!debug')

_srcdir="$startdir/../.."

build() {
  cd "$_srcdir"
  export CARGO_TARGET_DIR="$_srcdir/src-tauri/target"
  pnpm install --frozen-lockfile
  pnpm tauri build --no-bundle
}

package() {
  cd "$_srcdir"
  install -Dm755 src-tauri/target/release/foreverdb-uploader "$pkgdir/usr/bin/foreverdb-uploader"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/linux/foreverdb-uploader.desktop "$pkgdir/usr/share/applications/foreverdb-uploader.desktop"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/foreverdb-uploader.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/foreverdb-uploader.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/foreverdb-uploader.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/foreverdb-uploader.png"
}
