{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForeverDB Uploader",
  "version": "0.5.0",
  "identifier": "gg.foreverdb.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ForeverDB Uploader",
        "width": 1180,
        "height": 860,
        "minWidth": 520,
        "minHeight": 650,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "Alex Bangert",
    "homepage": "https://www.foreverdb.app",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Uploads ForeverCollect SavedVariables from World of Warcraft",
    "longDescription": "Desktop uploader for the SavedVariables of the ForeverCollect addon. Detects the World of Warcraft clients (Wine, Lutris, Faugus, Bottles, Windows), watches their ForeverCollect.lua and uploads every new write to the ForeverDB ingress automatically; every upload keeps an archive copy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
